---
/** «Как добраться»: таблица «Системные требования» + карта-маршрут (DESIGN.md §5). */
import { Picture } from 'astro:assets';
import Section from '../components/Section.astro';
import MapCard from '../components/MapCard.astro';
import { business } from '../data/site';
import { photos } from '../data/menu';
const tg = business.links.telegram;
---
<Section id="visit" title="Как добраться">
  <div class="visit">
    <div class="v-left">
      <div class="sign frame">
        <Picture src={photos['interior-wordmark']} alt="Золотая вывеска «ЗАГ-ЗАГ» над входом в таверну" widths={[560, 1190]} sizes="(min-width: 860px) 560px, 70vw" formats={['avif', 'webp']} class="sign-word" />
        <Picture src={photos['interior-lantern']} alt="Фонарь с горящей лампой на стене таверны" widths={[205]} sizes="130px" formats={['avif', 'webp']} class="sign-lamp" />
        <span class="plaque sign-tag">Вывеска таверны</span>
      </div>

      <table class="req">
        <caption>Системные требования</caption>
        <tbody>
          <tr><th scope="row">Минимальные</th><td>голод и&nbsp;компания</td></tr>
          <tr><th scope="row">Рекомендуемые</th><td>бронь стола</td></tr>
          <tr><th scope="row">Адрес</th><td>{business.address.city}, {business.address.street}</td></tr>
          <tr><th scope="row">Метро</th><td>«{business.metro.name}», <span class="num">340&nbsp;м</span></td></tr>
          <tr><th scope="row">Телефон</th><td><a class="link num" href={`tel:${business.phone.e164}`}>{business.phone.display}</a></td></tr>
          <tr><th scope="row">Telegram</th><td><a class="link" href={`https://t.me/${tg}`} target="_blank" rel="noopener">@{tg}</a></td></tr>
          <tr><th scope="row">Часы</th><td>{business.hoursDisplay}</td></tr>
        </tbody>
      </table>
      <a class="btn btn-primary btn-lg" href="#feast">Забронировать стол</a>
    </div>

    <div class="v-right"><MapCard note="От метро «Маяковская» — 340&nbsp;м" /></div>
  </div>
</Section>

<style>
  .visit { display: grid; gap: var(--s-8); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 900px) { .visit { grid-template-columns: 7fr 5fr; gap: var(--s-12); } }
  .v-left { display: flex; flex-direction: column; gap: var(--s-6); align-items: flex-start; }
  .v-left > .btn { align-self: stretch; }
  @media (min-width: 560px) { .v-left > .btn { align-self: flex-start; } }

  .sign { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: var(--s-4); background: var(--c-sunken); width: 100%; max-width: 40rem; }
  .sign :global(.sign-word) { display: block; flex: 1 1 auto; min-width: 0; max-width: 560px; }
  .sign :global(.sign-word img) { width: 100%; height: auto; object-fit: contain; }
  .sign :global(.sign-lamp) { display: block; flex: 0 0 auto; width: clamp(64px, 18vw, 130px); }
  .sign :global(.sign-lamp img) { width: 100%; height: auto; border-radius: var(--r-sm); }
  .sign-tag { position: absolute; left: var(--s-2); bottom: var(--s-2); }
  .sign { padding-bottom: calc(var(--s-4) + 2.5rem); }

  .req { width: 100%; border-collapse: collapse; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--r-md); }
  .req caption { text-align: left; font: 800 var(--t-h3)/1.15 var(--f-display); padding-bottom: var(--s-3); caption-side: top; }
  .req th, .req td { text-align: left; vertical-align: top; padding: var(--s-3) var(--s-4); border-top: 1px solid var(--c-border); line-height: 1.4; }
  .req th { width: 9.5rem; font: 700 var(--t-small)/1.4 var(--f-display); color: var(--c-muted); }
  .req td { overflow-wrap: anywhere; }
  .req a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
