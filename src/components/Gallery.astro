---
/**
 * Галерея с просмотром на весь экран: стрелки, свайп, клавиши ←/→, Esc, счётчик, фокус внутри.
 * Картинки — импортированные из src/assets (оптимизируются в AVIF/WebP) или пути из public/.
 *
 * import a from '../assets/shop-1.jpg';
 * <Gallery images={[{ src: a, alt: 'Витрина с приманками' }, …]} />
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Img { src: ImageMetadata | string; alt: string; width?: number; height?: number }
interface Props { images: Img[]; label?: string }
const { images, label = 'Фотографии' } = Astro.props;
const big = (img: Img) => (typeof img.src === 'string' ? img.src : img.src.src);
---
<div class="gal" data-gallery>
  <ul class="gal-grid" aria-label={label}>
    {images.map((img, i) => (
      <li>
        <button class="gal-thumb" type="button" data-index={i} data-full={big(img)} data-alt={img.alt} aria-label={`Открыть фото: ${img.alt}`}>
          {typeof img.src === 'string'
            ? <img src={img.src} alt={img.alt} width={img.width ?? 800} height={img.height ?? 600} loading="lazy" decoding="async" />
            : <Picture src={img.src} alt={img.alt} widths={[400, 800, 1200]} sizes="(min-width: 900px) 33vw, 50vw" formats={['avif', 'webp']} loading="lazy" />}
        </button>
      </li>
    ))}
  </ul>
  <dialog class="gal-box" aria-label={label}>
    <img class="gal-full" src={images[0] ? big(images[0]) : undefined} alt="" width="1600" height="1200" loading="lazy" decoding="async" />
    <p class="gal-count" aria-live="polite"></p>
    <button class="gal-nav gal-prev" type="button" aria-label="Предыдущее фото">‹</button>
    <button class="gal-nav gal-next" type="button" aria-label="Следующее фото">›</button>
    <button class="gal-close" type="button" aria-label="Закрыть">×</button>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('.gal-thumb')];
    const box = root.querySelector('dialog') as HTMLDialogElement;
    const full = box.querySelector('.gal-full') as HTMLImageElement;
    const count = box.querySelector('.gal-count') as HTMLElement;
    let i = 0, startX = 0;
    const show = (n: number) => {
      i = (n + thumbs.length) % thumbs.length;
      full.src = thumbs[i].dataset.full!;
      full.alt = thumbs[i].dataset.alt!;
      count.textContent = `${i + 1} из ${thumbs.length}`;
    };
    thumbs.forEach((t, n) => t.addEventListener('click', () => { show(n); box.showModal(); }));
    box.querySelector('.gal-prev')!.addEventListener('click', () => show(i - 1));
    box.querySelector('.gal-next')!.addEventListener('click', () => show(i + 1));
    box.querySelector('.gal-close')!.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
    box.addEventListener('close', () => thumbs[i]?.focus());
    box.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
    box.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    box.addEventListener('pointerup', (e) => { const d = e.clientX - startX; if (Math.abs(d) > 50) show(i + (d < 0 ? 1 : -1)); });
  });
</script>

<style>
  .gal-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .gal-thumb { display: block; width: 100%; padding: 0; border: 0; border-radius: var(--r-md); overflow: hidden; cursor: zoom-in; background: var(--c-surface); aspect-ratio: 4 / 3; }
  .gal-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--d-state) var(--e-out); }
  .gal-thumb:hover :global(img) { transform: scale(1.03); }
  .gal-box { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0; background: rgb(8 10 12 / 0.96); color: var(--lightbox-fg, #fff); }
  .gal-box::backdrop { background: rgb(0 0 0 / 0.6); }
  .gal-full { position: absolute; inset: var(--s-16) var(--s-4); width: calc(100% - 2 * var(--s-4)); height: calc(100% - 2 * var(--s-16)); object-fit: contain; }
  .gal-count { position: absolute; bottom: var(--s-4); left: 0; right: 0; text-align: center; margin: 0; font-size: var(--t-small); }
  .gal-nav, .gal-close { position: absolute; width: var(--tap); height: var(--tap); border: 0; border-radius: var(--r-pill); background: rgb(255 255 255 / 0.14); color: var(--lightbox-fg, #fff); font-size: 1.6rem; line-height: 1; cursor: pointer; }
  .gal-prev { left: var(--s-3); top: 50%; translate: 0 -50%; }
  .gal-next { right: var(--s-3); top: 50%; translate: 0 -50%; }
  .gal-close { right: var(--s-3); top: var(--s-3); }
</style>
