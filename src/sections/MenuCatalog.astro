---
/**
 * «Меню Орды» (DESIGN.md §5): каталог всех блюд из menu.ts. Каждое блюдо — DishCapsule.
 * Фильтры: категория + цена. Лидер категории 2×2, «Клановый пир» — широкая капсула 2×1.
 * «В бронь» дописывает название в textarea[name=items] формы внутри #feast; нет формы — ссылка просто ведёт к #feast.
 */
import Section from '../components/Section.astro';
import DishCapsule from '../components/DishCapsule.astro';
import { dishes, categories } from '../data/menu';

const FEAST = 'klanovyj-pir';
const band = (p: number) => (p < 500 ? 'low' : p < 1000 ? 'mid' : 'high');
const prices = [
  { id: 'low', label: 'До 500 ₽' },
  { id: 'mid', label: '500–1000 ₽' },
  { id: 'high', label: 'От 1000 ₽' },
];
const total = dishes.length;
---
<Section id="menu" title="Меню Орды">
  <div class="mc" data-menu data-total={total}>
    <div class="mc-filters">
      <div class="mc-row" role="group" aria-label="Категория">
        <span class="mc-lbl" aria-hidden="true">Категория</span>
        <button type="button" class="mc-chip" data-f="cat" data-v="" aria-pressed="true">Все</button>
        {categories.map((c) => <button type="button" class="mc-chip" data-f="cat" data-v={c.id} aria-pressed="false">{c.label}</button>)}
      </div>
      <div class="mc-row" role="group" aria-label="Цена">
        <span class="mc-lbl" aria-hidden="true">Цена</span>
        <button type="button" class="mc-chip" data-f="price" data-v="" aria-pressed="true">Любая</button>
        {prices.map((p) => <button type="button" class="mc-chip" data-f="price" data-v={p.id} aria-pressed="false" set:html={p.label} />)}
      </div>
    </div>
    <p class="mc-status" aria-live="polite"></p>

    <ul class="mc-grid">
      {dishes.map((d) => {
        const feast = d.slug === FEAST;
        return (
          <li
            class:list={['mc-item', feast && 'is-feast']}
            data-cat={d.category ?? ''}
            data-band={band(d.price)}
          >
            {feast && <p class="mc-set plaque">Набор</p>}
            <DishCapsule
              dish={d}
              ratio={feast ? '2 / 1' : '4 / 3'}
              widths={feast ? [480, 720, 1024] : [320, 480, 720]}
              sizes={feast
                ? '(min-width: 1024px) 640px, 100vw'
                : '(min-width: 1024px) 310px, (min-width: 390px) 50vw, 100vw'}
            />
            {feast
              ? <a class="mc-act mc-act-feast" href="#feast">Собрать клан на пир</a>
              : <a class="mc-act" href="#feast" data-add={d.name} aria-label={`В бронь: ${d.name}`}>В бронь</a>}
          </li>
        );
      })}
    </ul>
    <p class="mc-empty" hidden>Тут пусто, как в кружке после перекура. Сбрось фильтры.</p>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('.mc-item')];
    const status = root.querySelector<HTMLElement>('.mc-status')!;
    const empty = root.querySelector<HTMLElement>('.mc-empty')!;
    const total = Number(root.dataset.total) || items.length;
    const st: Record<string, string> = { cat: '', price: '' };
    const apply = () => {
      let n = 0;
      for (const it of items) {
        const ok = (!st.cat || it.dataset.cat === st.cat) && (!st.price || it.dataset.band === st.price);
        it.hidden = !ok;
        if (ok) n++;
      }
      empty.hidden = n > 0;
      status.textContent = st.cat || st.price ? `Показано блюд: ${n} из ${total}` : '';
    };
    root.querySelectorAll<HTMLButtonElement>('.mc-chip').forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.f!;
        st[f] = b.dataset.v ?? '';
        root.querySelectorAll<HTMLButtonElement>(`.mc-chip[data-f="${f}"]`).forEach((x) =>
          x.setAttribute('aria-pressed', String(x === b)),
        );
        apply();
      }),
    );
    root.querySelectorAll<HTMLAnchorElement>('[data-add]').forEach((a) =>
      a.addEventListener('click', (e) => {
        const field = document.querySelector<HTMLTextAreaElement>('#feast textarea[name="items"]');
        if (!field) return; // формы ещё нет — обычный переход к #feast
        e.preventDefault();
        const name = a.dataset.add!;
        const list = field.value.split(',').map((s) => s.trim()).filter(Boolean);
        if (!list.includes(name)) list.push(name);
        field.value = list.join(', ');
        field.dispatchEvent(new Event('input', { bubbles: true }));
        a.textContent = 'В брони';
        a.setAttribute('aria-label', `Добавлено в бронь: ${name}`);
        a.classList.add('is-added');
      }),
    );
  });
</script>

<style>
  .mc-filters { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); }
  .mc-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .mc-lbl { color: var(--c-muted); font-size: var(--t-small); min-width: 6rem; }
  .mc-chip {
    height: var(--tap); padding: 0 var(--s-4); border-radius: var(--r-sm);
    border: 1px solid var(--c-border); background: var(--c-sunken); color: var(--c-text);
    font: 500 var(--t-small)/1 var(--f-body); cursor: pointer;
    transition: background-color var(--d-micro) var(--e-out), color var(--d-micro) var(--e-out);
  }
  .mc-chip[aria-pressed='true'] { background: var(--c-accent); color: var(--c-on-accent); border-color: var(--c-accent); }
  .mc-status { margin: 0 0 var(--s-4); color: var(--c-muted); font-size: var(--t-small); }
  .mc-status:empty { display: none; }
  .mc-empty { color: var(--c-muted); font-size: var(--t-body); }

  .mc-grid {
    list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-6) 12px;
    grid-template-columns: 1fr; grid-auto-flow: row dense;
  }
  .mc-item { position: relative; display: flex; flex-direction: column; gap: var(--s-2); min-width: 0; }
  .mc-item[hidden] { display: none; }
  .mc-item :global(.capsule) { flex: 1; display: flex; flex-direction: column; }

  .mc-act {
    margin-top: auto; align-self: flex-start; min-height: 44px; display: inline-flex; align-items: center;
    padding: 0 var(--s-4); border: 1px solid var(--c-accent); border-radius: var(--r-sm);
    color: var(--c-text); font: 700 var(--t-small)/1 var(--f-display); text-decoration: none;
    transition: background-color var(--d-micro) var(--e-out);
  }
  .mc-act:hover { background: var(--c-sunken); }
  .mc-act.is-added { color: var(--c-accent-text); }
  .mc-act-feast { background: var(--c-accent); color: var(--c-on-accent); }
  .mc-act-feast:hover { background: var(--c-accent-text); }
  .mc-set { position: absolute; z-index: 1; top: var(--s-2); left: var(--s-2); margin: 0; }

  @media (min-width: 390px) {
    .mc-grid { grid-template-columns: repeat(2, 1fr); }
    .is-feast { grid-column: span 2; }
  }
  @media (min-width: 768px) { .mc-grid { column-gap: 20px; } }
  @media (min-width: 1024px) {
    .mc-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 389px) { .mc-lbl { min-width: 100%; } }
</style>
